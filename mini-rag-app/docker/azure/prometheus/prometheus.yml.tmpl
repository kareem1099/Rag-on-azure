global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # FastAPI is reached through its public HTTPS ingress; /metrics is guarded by METRICS_TOKEN,
  # which is mounted here from the container app secret.
  - job_name: fastapi
    scheme: https
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/metrics-token
    static_configs:
      - targets: ["__FASTAPI_HOST__"]

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
